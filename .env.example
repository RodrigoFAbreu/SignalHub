# Copy to .env and fill in. Never commit .env.
# Docker Compose reads .env automatically (see docs/development.md).

# Password for the PostgreSQL "signalhub" user. Required.
# It is embedded in a database URL, so use URL-safe characters only, e.g.:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Host ports, bound to 127.0.0.1 only. Defaults shown.
# SIGNALHUB_PORT=8000
# POSTGRES_PORT=5432
