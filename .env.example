# Copy to .env (git-ignored) and fill in real values. Used by compose.yaml.
# Placeholders only: never commit real credentials.

# Required. Choose a strong password; it is set when the volume is first created.
SIGNALHUB_DB_PASSWORD=change-me

# Enables the management API (/api/v1/admin/producers and /api/v1/admin/clients),
# which issues producer API keys and client keys. At least 32 characters;
# generate one with
#   openssl rand -hex 32
# Leave empty to disable the management API.
SIGNALHUB_ADMIN_TOKEN=

# Optional, shown with their defaults.
# SIGNALHUB_DB_NAME=signalhub
# SIGNALHUB_DB_USERNAME=signalhub
# SIGNALHUB_HTTP_PORT=8080
# true writes JSON logs (one object per line) for log collectors.
# SIGNALHUB_LOG_JSON=false
# How long events are kept, at least 1d, such as 365d; older ones are deleted.
# Empty keeps events forever.
# SIGNALHUB_EVENTS_RETENTION=
